# Node dependencies
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov/

# Coverage directory used by tools like istanbul
coverage/

# nyc test coverage
.nyc_output/

# Build output
dist/
build/

# Optional npm cache directory
.npm/

# dotenv environment variables
.env
.env.* # like .env.development, .env.production

# Mac system files
.DS_Store

# Debug and VSCode settings
.vscode/

# TypeScript cache
*.tsbuildinfo

# Temporary files
tmp/
temp/

# Swagger generated docs (if used)
swagger-static/

# Logs from Nest CLI (if any)
nestjs-debug.log
